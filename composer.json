{
    "name": "jdz/emailobfuscator",
    "type": "library",
    "description": "Server-side email obfuscation paired with the jizy-obfuscator JS client",
    "homepage": "https://jdz.joffreydemetz.com/emailObfuscator",
    "license": "MIT",
    "keywords": [
        "JDZ",
        "email",
        "obfuscator",
        "twig"
    ],
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\EmailObfuscator\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\EmailObfuscator\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}